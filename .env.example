# Copy to .env and edit. Read by docker compose.
# Set a long random password before exposing the sandbox to the internet.
ACCESS_TOKEN=
# 127.0.0.1 = only this machine. 0.0.0.0 = reachable from outside (use with ACCESS_TOKEN).
BIND_ADDR=127.0.0.1
PORT=8000
MAX_CONCURRENT_RENDERS=1
MEMORY_LIMIT=2g
CPU_LIMIT=2
